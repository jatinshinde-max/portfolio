{
  "rewrites": [
    { "source": "/test-mp4",  "destination": "/test-mp4.html" },
    { "source": "/test-seq",  "destination": "/test-seq.html" },
    { "source": "/type-a",    "destination": "/type-a.html" },
    { "source": "/type-b",    "destination": "/type-b.html" },
    { "source": "/type-c",    "destination": "/type-c.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}]
    },
    {
      "source": "/dist/(.*)",
      "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}]
    }
  ]
}
